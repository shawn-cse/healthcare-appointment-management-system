# ==============================================================================
# Green Hospital Doctor Appointment Management System
# Environment Configuration Template (.env.example)
#
# IMPORTANT:
# - Copy this file to `.env` for local development or staging.
# - DO NOT commit real secrets, API keys, or production credentials to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Core Application Settings
# ------------------------------------------------------------------------------
# Generate a cryptographically secure key for staging/production:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production

# Set to False in Staging and Production environments
DEBUG=True

# Comma-separated list of valid host/domain names
ALLOWED_HOSTS=localhost,127.0.0.1,hospital.example.com

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# Option A: DATABASE_URL (Recommended for 12-factor / Docker / Cloud)
# Format: postgresql://username:password@host:port/database_name
# DATABASE_URL=postgresql://green_hospital_user:secure_db_password@db:5432/green_hospital_db

# Option B: Individual PostgreSQL parameters
POSTGRES_DB=green_hospital_db
POSTGRES_USER=green_hospital_user
POSTGRES_PASSWORD=secure_local_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Option C: If neither DATABASE_URL nor POSTGRES_DB is supplied,
# SQLite (db.sqlite3) is used automatically as fallback for local dev.

# ------------------------------------------------------------------------------
# 3. Payment Gateway Configuration (SSLCOMMERZ & Mock)
# ------------------------------------------------------------------------------
# Provider: 'sslcommerz' for gateway or 'mock' for local sandbox development
PAYMENT_GATEWAY_PROVIDER=mock

# SSLCOMMERZ Merchant Credentials (keep sandbox and production credentials separate)
# For local dev / testing, use the mock provider or sandbox credentials provided by SSLCOMMERZ
SSLCOMMERZ_STORE_ID=test_store_id
SSLCOMMERZ_STORE_PASS=test_store_pass
SSLCOMMERZ_IS_SANDBOX=True

# Online payment checkout session expiration in minutes (default: 15)
PAYMENT_CHECKOUT_TIMEOUT_MINUTES=15

# ------------------------------------------------------------------------------
# 4. Email Notification Settings (SMTP)
# ------------------------------------------------------------------------------
# For development, use console backend: django.core.mail.backends.console.EmailBackend
# For production, use SMTP: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.mailgun.org
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=notifications@greenhospital.org
EMAIL_HOST_PASSWORD=smtp_secure_password
DEFAULT_FROM_EMAIL="Green Hospital <notifications@greenhospital.org>"

# ------------------------------------------------------------------------------
# 5. SMS Notification Settings (Bangladesh SMS Gateways)
# ------------------------------------------------------------------------------
# Provider: 'mock' (logs to file/console) or 'greenweb' / 'sslwireless'
SMS_GATEWAY_PROVIDER=mock
SMS_API_KEY=your_bangladesh_sms_gateway_api_key
SMS_SENDER_ID=GreenHospital

# ------------------------------------------------------------------------------
# 6. Production Security & HTTPS Settings
# ------------------------------------------------------------------------------
# Keep False during local HTTP development; set True in Staging/Production with HTTPS
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
