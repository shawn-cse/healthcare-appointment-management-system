# Application Security & Runtime
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_JWT_SECRET_BEFORE_DEPLOYMENT
TIME_ZONE=Asia/Dhaka

# PostgreSQL Database
DATABASE_NAME=green_hospital
DATABASE_USER=green_user
DATABASE_PASSWORD=change_this_database_password
DATABASE_HOST=db
DATABASE_PORT=5432

# Hospital Configuration
HOSPITAL_NAME=Green Hospital
HOSPITAL_PHONE=+88096100016211
HOSPITAL_ADDRESS=Dhaka, Bangladesh
# For public deployment set the HTTPS base URL; localhost callbacks cannot reach SSLCOMMERZ.
PUBLIC_BASE_URL=http://localhost:8000

# SSLCOMMERZ Payment Gateway
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_LIVE=0

# Seed starter accounts only when initializing an empty database
SEED_STARTER_ACCOUNTS=0
# Set briefly to provision the first administrator on an empty deployment.
BOOTSTRAP_ADMIN_USERNAME=hospital_admin
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional HTTPS SMS adapter for patient phone verification.
PHONE_SMS_WEBHOOK=
PHONE_SMS_TOKEN=

# Starter users are for isolated development databases.
SEED_STARTER_PASSWORD=
