# Django Secret Key & Debug Mode
SECRET_KEY=g!y0otek@9t^b+b*7)&q2a5^=8_9&xcdii8@6h^_*wphl-(fu9
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Defaults to SQLite for local development)
DATABASE_URL=sqlite:///db.sqlite3

# ==============================================================================
# Payment Gateway Configuration (Phase 7: SSLCOMMERZ & Safe Mock Gateway)
# ==============================================================================

# Active Payment Provider: 'sslcommerz' for live or sandbox; 'mock' for local development
PAYMENT_GATEWAY_PROVIDER=mock

# Allow mock payments locally without external internet/credentials (disabled in production)
ALLOW_MOCK_PAYMENTS=True

# SSLCOMMERZ Merchant Credentials
# Register at https://developer.sslcommerz.com/ to obtain sandbox test credentials
SSLCOMMERZ_STORE_ID=your_store_id_here
SSLCOMMERZ_STORE_PASS=your_store_password_here

# SSLCOMMERZ Sandbox Mode:
# 'true' uses https://sandbox.sslcommerz.com/
# 'false' uses production https://securepay.sslcommerz.com/
SSLCOMMERZ_IS_SANDBOX=True

# Checkout session expiry in minutes (releases appointment capacity if unpaid/abandoned)
PAYMENT_CHECKOUT_TIMEOUT_MINUTES=15
